# Projeto REDE — template de variáveis de ambiente
# Copie para .env.local e preencha. NUNCA comite .env.local.
# As mesmas variáveis precisam ser cadastradas na Vercel.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Server-only. NUNCA com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site. Usada nas meta tags Open Graph e na montagem do
# link de cadastro que vai para a liderança.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# A ausência de NEXT_PUBLIC_SUPABASE_ANON_KEY é intencional.
# Se ela aparecer no projeto em algum momento, alguma coisa saiu do desenho.

# Chave anon, SERVER-ONLY (sem prefixo NEXT_PUBLIC_).
# Usada só como apikey do fluxo de auth da coordenacao, que roda inteiro em
# Server Action. O role anon nao tem policy nenhuma, entao ela nao abre porta.
SUPABASE_ANON_KEY=
