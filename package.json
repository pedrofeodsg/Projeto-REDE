    "testa:captura": "node --conditions=react-server scripts/testa-captura.mjs",
    "testa:temperatura": "node scripts/testa-temperatura.mjs",
    "testa:territorio": "node scripts/testa-territorio.mjs",
    "testa:relacionamento": "node scripts/testa-relacionamento.mjs",
    "testa:instagram": "node scripts/testa-instagram.mjs"
